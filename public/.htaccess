# Estante · configuração Apache/LiteSpeed (Hostinger)

# --- Fallback de SPA: rotas inexistentes servem o index.html ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Tipos MIME (worker do pdf.js é .mjs) ---
<IfModule mod_mime.c>
  AddType application/javascript .mjs .js
  AddType application/wasm .wasm
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg .svgz
</IfModule>

# --- Compressão GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/wasm image/svg+xml
</IfModule>

# --- Cache de navegador ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Assets com hash no nome podem cachear por 1 ano
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Segurança básica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Bloqueio de arquivos sensíveis ---
<FilesMatch "^\.|\.env$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
